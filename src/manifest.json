{
    "manifest_version": 3,
    "default_locale": "en",
    "name": "__MSG_extensionName__",
    "version": "0.2",
    "description": "__MSG_extensionDescription__",
    "developer": {
        "name": "Ryan Young",
        "url": "https://github.com/YoRyan/cleantainer"
    },
    "browser_specific_settings": {
        "gecko": {
            "id": "cleantainer@youngryan.com"
        }
    },
    "permissions": ["storage", "browsingData", "contextualIdentities"],

    "background": {
        "scripts": ["js/background.js"],
        "type": "module"
    },
    "action": {
        "default_title": "__MSG_extensionName__",
        "default_popup": "popup.html",
        "theme_icons": [
            {
                "light": "img/placeholder-16.png",
                "dark": "img/placeholder-16.png",
                "size": 16
            },
            {
                "light": "img/placeholder-32.png",
                "dark": "img/placeholder-32.png",
                "size": 32
            }
        ]
    },
    "options_ui": {
        "page": "options.html"
    },
    "icons": {
        "32": "img/placeholder-32.png",
        "64": "img/placeholder-32.png"
    },
    "commands": {
        "quick-list-1": {
            "suggested_key": {
                "default": "Alt+Shift+Delete",
                "mac": "Command+MacCtrl+Delete",
                "chromeos": "Alt+Shift+0"
            },
            "description": "__MSG_quickList1Shortcut__"
        }
    }
}
